{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://tennis-web.sales-fd3.workers.dev/sitemap.xml"
    },
    {
      "source": "/og/:path*",
      "destination": "https://tennis-web.sales-fd3.workers.dev/og/:path*"
    },
    {
      "source": "/players/:slug",
      "destination": "https://tennis-web.sales-fd3.workers.dev/players/:slug"
    },
    {
      "source": "/players/:slug/:tab",
      "destination": "https://tennis-web.sales-fd3.workers.dev/players/:slug/:tab"
    },
    {
      "source": "/tournaments/:slug/:year",
      "destination": "https://tennis-web.sales-fd3.workers.dev/tournaments/:slug/:year"
    },
    {
      "source": "/tournaments/:slug/:year/:event",
      "destination": "https://tennis-web.sales-fd3.workers.dev/tournaments/:slug/:year/:event"
    },
    {
      "source": "/matches/:id",
      "destination": "https://tennis-web.sales-fd3.workers.dev/matches/:id"
    },
    {
      "source": "/pbecast/:id",
      "destination": "https://tennis-web.sales-fd3.workers.dev/pbecast/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://tennis-api.propbetedge.ai https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://tennis-api.propbetedge.ai https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tenniscast",
      "destination": "/pbecast",
      "permanent": true
    },
    {
      "source": "/rankings",
      "destination": "/rankings/women",
      "permanent": false
    }
  ]
}
